---
const projects = [
  { number: '01', name: 'Interactive Resume', type: 'Personal portfolio', description: 'A focused home for the work, the craft, and the thinking behind each build.', stack: ['Astro', 'TypeScript', 'GSAP'], tone: 'from-violet-500/30 via-indigo-500/10 to-transparent', href: 'https://github.com/Sindhujaa123/interactive-resume', label: 'View repository' },
  { number: '02', name: 'Interface Systems', type: 'Design engineering', description: 'A component-first approach to building consistent, accessible product interfaces.', stack: ['UI systems', 'Accessibility', 'CSS'], tone: 'from-emerald-400/25 via-teal-500/10 to-transparent', href: 'https://github.com/Sindhujaa123', label: 'Explore GitHub' },
  { number: '03', name: 'Motion Studies', type: 'Interaction design', description: 'Small, purposeful motion experiments that help digital interfaces tell a clearer story.', stack: ['GSAP', 'Motion', 'Prototyping'], tone: 'from-fuchsia-400/25 via-purple-500/10 to-transparent', href: 'https://github.com/Sindhujaa123', label: 'Explore GitHub' },
];
---
<section id="projects" class="container-shell py-24 sm:py-32">
  <div class="mb-12 flex flex-col justify-between gap-5 sm:flex-row sm:items-end" data-reveal><div><p class="eyebrow mb-4">03 / Selected directions</p><h2 class="text-3xl font-semibold tracking-[-.05em] sm:text-5xl">Good ideas, <span class="text-zinc-500">made tangible.</span></h2></div><p class="max-w-sm text-sm leading-6 text-zinc-500">A glimpse at the areas I build in: digital experiences, thoughtful systems, and expressive interactions.</p></div>
  <div class="grid gap-4 md:grid-cols-2">
    {projects.map((project, index) => <article class={`card glass group overflow-hidden ${index === 0 ? 'md:col-span-2' : ''}`} data-reveal>
      <a class="block" href={project.href} target="_blank" rel="noreferrer" aria-label={`${project.label}: ${project.name}`}>
        <div class={`relative ${index === 0 ? 'h-64 sm:h-80' : 'h-56'} overflow-hidden bg-gradient-to-br ${project.tone}`}>
          <div class="absolute inset-0 opacity-50" style="background-image: radial-gradient(rgba(255,255,255,.20) 1px, transparent 1px); background-size: 22px 22px;"></div>
          {index === 0 ? <div class="absolute left-[10%] top-[16%] w-[80%] rounded-xl border border-white/15 bg-[#111116]/85 p-5 shadow-2xl backdrop-blur-xl transition duration-700 group-hover:scale-[1.025] sm:p-7"><div class="flex items-center gap-1.5"><i class="h-2 w-2 rounded-full bg-rose-300/80"></i><i class="h-2 w-2 rounded-full bg-amber-200/80"></i><i class="h-2 w-2 rounded-full bg-emerald-200/80"></i><span class="ml-3 font-mono text-[9px] text-zinc-500">sindhujaa.dev / selected work</span></div><div class="mt-8 grid gap-4 sm:grid-cols-[1fr_190px]"><div><div class="h-2 w-14 rounded-full bg-violet-300/80"></div><div class="mt-4 h-4 w-[80%] rounded-full bg-white/80"></div><div class="mt-2 h-4 w-[60%] rounded-full bg-white/30"></div><div class="mt-5 h-2 w-[72%] rounded-full bg-white/10"></div><div class="mt-2 h-2 w-[58%] rounded-full bg-white/10"></div></div><div class="hidden rounded-lg border border-white/10 bg-gradient-to-br from-violet-400/20 to-emerald-200/10 sm:block"></div></div></div> : <div class="absolute left-1/2 top-1/2 grid h-32 w-48 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-2xl border border-white/15 bg-white/[.06] shadow-2xl backdrop-blur-md transition duration-500 group-hover:rotate-[-3deg] group-hover:scale-105"><span class="font-mono text-4xl font-medium text-white/90">{project.number}<span class="text-accent">/</span></span></div>}
          <span class="absolute right-5 top-5 grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-black/20 text-lg transition group-hover:-translate-y-1 group-hover:translate-x-1">↗</span>
        </div>
        <div class="flex flex-col justify-between gap-5 p-6 sm:flex-row sm:items-end sm:p-7"><div><p class="eyebrow">{project.type}</p><h3 class="mt-2 text-xl font-semibold tracking-tight">{project.name}</h3><p class="mt-2 max-w-xl text-sm leading-6 text-zinc-400">{project.description}</p><div class="mt-4 flex flex-wrap gap-2">{project.stack.map((tag) => <span class="rounded-full border border-white/10 px-2.5 py-1 font-mono text-[10px] text-zinc-400">{tag}</span>)}</div></div><span class="shrink-0 text-sm text-zinc-300 transition group-hover:text-white">{project.label} ↗</span></div>
      </a>
    </article>)}
  </div>
</section>

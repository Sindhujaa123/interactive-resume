---
import { projects } from '../data/projects';
---
<section id="projects" class="container-shell scroll-mt-28 py-24 sm:py-32">
  <div class="mb-10 flex flex-col justify-between gap-4 lg:flex-row lg:items-end" data-reveal>
    <div><p class="eyebrow mb-4">03 / Selected projects</p><h2 class="text-3xl font-semibold tracking-[-.05em] sm:text-5xl">Built to answer<br/><span class="text-gradient">real questions.</span></h2></div>
    <p class="max-w-md text-sm leading-6 text-zinc-500">Applied AI, financial risk analysis, and NLP—shown with the methods and outcomes documented in my resume.</p>
  </div>
  <div class="grid gap-4">
    {projects.map((project, index) => <article class={`card glass group overflow-hidden ${index === 0 ? 'border-accent/20' : ''}`} data-reveal>
      <div class="grid lg:grid-cols-[.82fr_1.18fr]">
        <div class={`relative min-h-[210px] overflow-hidden border-b border-white/10 bg-gradient-to-br ${project.visual === 'rag' ? 'from-violet-500/20 via-indigo-500/[.07] to-transparent' : project.visual === 'risk' ? 'from-emerald-400/15 via-teal-500/[.06] to-transparent' : 'from-fuchsia-400/15 via-purple-500/[.06] to-transparent'} p-5 sm:min-h-[250px] lg:border-b-0 lg:border-r`} aria-hidden="true">
          {project.visual === 'rag' && <div class="flex h-full min-h-[170px] flex-col justify-center gap-3">
            <div class="flex flex-wrap items-center gap-2"><span class="rounded-lg border border-white/10 bg-black/20 px-3 py-2 font-mono text-[10px] text-zinc-300">4 business docs</span><span class="text-accent">→</span><span class="rounded-lg border border-white/10 bg-black/20 px-3 py-2 font-mono text-[10px] text-zinc-300">File Search</span></div>
            <div class="ml-8 h-5 border-l border-dashed border-accent/50"></div>
            <div class="flex flex-wrap items-center gap-2"><span class="rounded-lg border border-accent/25 bg-accent/10 px-3 py-2 font-mono text-[10px] text-accent">Foundry Agent</span><span class="text-mint">→</span><span class="rounded-lg border border-mint/20 bg-mint/10 px-3 py-2 font-mono text-[10px] text-mint">Grounded response</span></div>
          </div>}
          {project.visual === 'risk' && <div class="grid h-full min-h-[170px] grid-cols-2 gap-2">
            <div class="rounded-xl border border-white/10 bg-black/15 p-3"><span class="font-mono text-[9px] uppercase tracking-wider text-zinc-500">Company profile</span><div class="mt-4 space-y-2"><i class="block h-1.5 w-4/5 rounded-full bg-emerald-200/60"></i><i class="block h-1.5 w-3/5 rounded-full bg-white/15"></i><i class="block h-1.5 w-2/3 rounded-full bg-white/15"></i></div></div>
            <div class="rounded-xl border border-white/10 bg-black/15 p-3"><span class="font-mono text-[9px] uppercase tracking-wider text-zinc-500">Risk dimensions</span><div class="mt-3 grid grid-cols-4 gap-1">{Array.from({ length: 16 }, (_, cell) => <i class={`aspect-square rounded-sm ${cell % 5 === 0 ? 'bg-emerald-200/60' : cell % 3 === 0 ? 'bg-amber-200/35' : 'bg-white/10'}`}></i>)}</div></div>
            <div class="col-span-2 rounded-xl border border-white/10 bg-black/15 p-3"><span class="font-mono text-[9px] uppercase tracking-wider text-zinc-500">Sector comparison</span><div class="mt-3 flex h-8 items-end gap-1">{[28, 60, 42, 78, 52, 67, 36, 85, 48, 72, 40, 61].map((height) => <i class="flex-1 rounded-t-sm bg-gradient-to-t from-emerald-400/20 to-emerald-200/70" style={`height:${height}%`}></i>)}</div></div>
          </div>}
          {project.visual === 'nlp' && <div class="flex h-full min-h-[170px] flex-col justify-center gap-4">
            <div class="flex items-center gap-2 font-mono text-[10px] text-zinc-400"><span class="rounded-lg border border-white/10 bg-black/20 px-3 py-2">~2,400 resumes</span><span class="text-fuchsia-200">→</span><span class="rounded-lg border border-white/10 bg-black/20 px-3 py-2">25 categories</span></div>
            <div class="space-y-3 rounded-xl border border-white/10 bg-black/15 p-4"><div><div class="mb-1 flex justify-between font-mono text-[10px] text-zinc-400"><span>Logistic Regression</span><span>64.7%</span></div><div class="h-2 rounded-full bg-white/10"><i class="block h-full w-[64.7%] rounded-full bg-accent"></i></div></div><div><div class="mb-1 flex justify-between font-mono text-[10px] text-zinc-400"><span>MLP</span><span>56.1%</span></div><div class="h-2 rounded-full bg-white/10"><i class="block h-full w-[56.1%] rounded-full bg-fuchsia-200/70"></i></div></div></div>
          </div>}
          {project.visual === 'music' && <div class="flex h-full min-h-[170px] items-center justify-center gap-3">
            {['♫', '♫', '♫'].map((note, noteIndex) => <span class={`grid h-14 w-14 place-items-center rounded-2xl border border-fuchsia-200/20 bg-fuchsia-300/10 text-2xl text-fuchsia-100`} style={`transform: translateY(${noteIndex === 1 ? '-12px' : '8px'}) rotate(${noteIndex === 0 ? '-8deg' : noteIndex === 2 ? '8deg' : '0deg'})`}>{note}</span>)}
          </div>}
        </div>
        <div class="p-6 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3"><p class="eyebrow">0{index + 1} / {project.kind}</p><span class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">Project work</span></div>
          <div class="mt-3 flex items-center justify-between gap-4">
            <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">{project.name}</h3>
            <img class="h-14 w-24 shrink-0 rounded-xl border border-white/10 bg-black/20 object-contain p-1.5" src={project.logo} alt={`${project.name} logo`} width="96" height="56" loading="lazy" />
          </div>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-400">{project.summary}</p>
          <div class="mt-5 border-l border-accent/35 pl-4"><p class="eyebrow mb-2">My contribution</p><p class="text-sm leading-6 text-zinc-300">{project.contribution}</p></div>
          <div class="mt-5 flex flex-wrap gap-2">{project.tools.map((tool) => <span class="rounded-full border border-white/10 px-2.5 py-1 font-mono text-[9px] text-zinc-400">{tool}</span>)}</div>
          <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-white/10 pt-4">{project.evidence.map((item) => <li class="flex items-center gap-2 text-xs text-zinc-300"><span class="h-1.5 w-1.5 rounded-full bg-mint" aria-hidden="true"></span>{item}</li>)}</ul>
          {project.demoUrl && <a class="mt-5 inline-flex min-h-10 items-center gap-2 rounded-lg border border-emerald-200/25 bg-emerald-200/10 px-4 py-2 text-sm font-semibold text-emerald-100 transition-colors hover:border-emerald-100/50 hover:bg-emerald-100/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-200" href={project.demoUrl} target="_blank" rel="noreferrer">Open live demo <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </article>)}
  </div>
  <p class="mt-4 text-xs leading-5 text-zinc-600">MoodMix and the financial dashboard have live demos.</p>
</section>

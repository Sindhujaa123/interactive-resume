---
import { skillGroups } from '../data/profile';
---
<section id="about" class="container-shell py-24 sm:py-32">
  <div class="mb-9 max-w-3xl" data-reveal>
    <p class="eyebrow mb-4">01 / About</p>
    <h2 class="text-3xl font-semibold leading-tight tracking-[-.05em] sm:text-5xl">Computer science thinking.<br/><span class="text-gradient">Business analytics context.</span></h2>
    <p class="mt-5 max-w-2xl text-sm leading-7 text-zinc-400 sm:text-base">My work sits between data, software, and business questions. I enjoy making messy information useful, testing where AI can help, and building tools people can act on.</p>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Experience highlights">
    <article class="card glass p-5" data-reveal><p class="eyebrow">Data handled</p><p class="mt-3 text-3xl font-semibold tracking-[-.06em]">~15,000</p><p class="mt-2 text-xs leading-5 text-zinc-400">Operational and financial records processed during internship</p></article>
    <article class="card glass p-5" data-reveal><p class="eyebrow">Reporting</p><p class="mt-3 text-3xl font-semibold tracking-[-.06em]">3 dashboards</p><p class="mt-2 text-xs leading-5 text-zinc-400">Interactive Power BI views for costs, KPIs, and operations</p></article>
    <article class="card glass p-5" data-reveal><p class="eyebrow">Data quality</p><p class="mt-3 text-3xl font-semibold tracking-[-.06em] text-mint">+5%</p><p class="mt-2 text-xs leading-5 text-zinc-400">Database accuracy improvement from validation checks</p></article>
    <article class="card glass p-5" data-reveal><p class="eyebrow">Manual reporting</p><p class="mt-3 text-3xl font-semibold tracking-[-.06em] text-accent">−25%</p><p class="mt-2 text-xs leading-5 text-zinc-400">Effort reduced by streamlining Excel reporting workflows</p></article>
  </div>
</section>

<section id="skills" class="container-shell scroll-mt-28 pb-24 sm:pb-32">
  <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between" data-reveal>
    <div><p class="eyebrow mb-3">02 / Skills</p><h2 class="text-3xl font-semibold tracking-[-.05em] sm:text-4xl">A practical toolkit.</h2></div>
    <p class="max-w-md text-sm leading-6 text-zinc-500">Grouped around the work shown here: analysis, modeling, application development, and delivery.</p>
  </div>
  <div class="grid gap-3 md:grid-cols-2">
    {skillGroups.map((group) => <article class="card glass p-5 sm:p-6" data-reveal>
      <h3 class="text-sm font-semibold text-zinc-100">{group.category}</h3>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label={group.category}>
        {group.skills.map((skill) => <li class="rounded-full border border-white/10 bg-white/[.035] px-3 py-1.5 font-mono text-[10px] text-zinc-300 sm:text-[11px]">{skill}</li>)}
      </ul>
    </article>)}
  </div>
</section>

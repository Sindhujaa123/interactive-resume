---
const credentials = [
  { name: 'Google Analytics', provider: 'Google', mark: 'G', company: 'Google' },
  { name: 'AWS Cloud Essentials', provider: 'Amazon Web Services', mark: 'aws', company: 'AWS', url: 'https://www.credly.com/badges/72638994-3dc6-4232-a49c-99a90cf86b2b/public_url' },
  { name: 'AWS AI-Driven Development Lifecycle', provider: 'Amazon Web Services', mark: 'aws', company: 'AWS', url: 'https://www.credly.com/badges/19239bf5-93ae-4df8-9ab0-81e4ec3db72b/public_url' },
  { name: 'AWS Compute Programming & Libraries', provider: 'Amazon Web Services', mark: 'aws', company: 'AWS', url: 'https://www.credly.com/badges/3d5477a0-18c9-4278-be71-8ba152a36029/public_url' },
];
---
<section id="credentials" class="container-shell scroll-mt-28 py-24 sm:py-32">
  <div class="mb-9 flex flex-col justify-between gap-4 sm:flex-row sm:items-end" data-reveal>
    <div><p class="eyebrow mb-4">05 / Learning</p><h2 class="text-3xl font-semibold tracking-[-.05em] sm:text-5xl">Credentials & badges.</h2></div>
    <p class="max-w-md text-xs leading-5 text-zinc-500">Google Analytics certification from Google and AWS credentials issued by Amazon Web Services.</p>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    {credentials.map((credential) => <article class="card glass flex min-h-40 flex-col justify-between p-5" data-reveal>
      <div class="flex items-start justify-between gap-3"><span class="grid h-10 min-w-10 place-items-center rounded-xl border border-white/10 bg-white/[.04] px-2"><img class="max-h-6 max-w-8" src={credential.company === 'Google' ? 'https://cdn.simpleicons.org/googleanalytics/F9AB00' : 'https://cdn.simpleicons.org/amazonaws/FF9900'} alt={`${credential.company} logo`} loading="lazy" /></span><span class="rounded-full border border-white/10 px-2 py-1 font-mono text-[8px] uppercase tracking-wider text-zinc-500">{'url' in credential ? 'Credly badge' : 'Resume-listed'}</span></div>
      <div class="mt-7"><h3 class="text-sm font-semibold leading-5 text-zinc-100">{credential.name}</h3><p class="mt-1.5 text-[10px] text-zinc-500">{credential.provider}</p>{'url' in credential && <a class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-accent transition-colors hover:text-zinc-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href={credential.url} target="_blank" rel="noreferrer">View verified badge <span aria-hidden="true">↗</span></a>}</div>
    </article>)}
  </div>
</section>

<section id="education" class="container-shell scroll-mt-28 pb-24 sm:pb-32">
  <div class="mb-8" data-reveal><p class="eyebrow mb-3">06 / Education</p><h2 class="text-3xl font-semibold tracking-[-.05em] sm:text-4xl">Learning with analytical depth.</h2></div>
  <div class="grid gap-3 lg:grid-cols-2">
    <article class="glass card flex flex-col justify-between gap-6 p-6 sm:p-8" data-reveal>
      <div><p class="eyebrow">University of Louisville</p><h3 class="mt-2 text-xl font-semibold">Master of Science, Business Analytics</h3><p class="mt-2 text-sm font-medium text-mint">AI concentration</p><p class="mt-2 text-sm text-zinc-400">Aug 2025 — Aug 2026</p></div>
      <div class="self-start rounded-2xl border border-mint/20 bg-mint/[.06] px-5 py-4"><p class="eyebrow text-mint">GPA</p><p class="mt-1 text-2xl font-semibold tracking-tight">3.8 <span class="text-sm font-normal text-zinc-500">/ 4.0</span></p></div>
    </article>
    <article class="glass card flex flex-col justify-between gap-6 p-6 sm:p-8" data-reveal>
      <div><img class="mb-4 h-auto w-32 rounded bg-white p-1" src="https://www.anurag.edu.in/assets/images/358a0b743e7fbbd8be475f4dca39d275afe10fa5-352x76.png?auto=format&amp;q=85&amp;w=1920" alt="Anurag University logo" loading="lazy" /><p class="eyebrow">Anurag University</p><h3 class="mt-2 text-xl font-semibold">CSE <span class="text-base font-normal text-zinc-400">(Computer Science and Engineering)</span></h3><p class="mt-2 text-sm text-zinc-400">2021 — 2025</p></div>
      <div class="self-start rounded-2xl border border-accent/20 bg-accent/[.06] px-5 py-4"><p class="eyebrow text-accent">GPA</p><p class="mt-1 text-2xl font-semibold tracking-tight">8.5 <span class="text-sm font-normal text-zinc-500">/ 10</span></p></div>
    </article>
  </div>
</section>

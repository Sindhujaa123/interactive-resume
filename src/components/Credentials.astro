---
const credentials = [
  { name: 'Google Analytics', provider: 'Issuer not specified in resume', mark: 'GA' },
  { name: 'AWS Cloud Essentials', provider: 'AWS · listed on resume', mark: 'AWS' },
  { name: 'AWS AI-Driven Development Lifecycle', provider: 'AWS · listed on resume', mark: 'AI' },
  { name: 'AWS Compute Programming & Libraries', provider: 'AWS · listed on resume', mark: 'DEV' },
];
---
<section id="credentials" class="container-shell scroll-mt-28 py-24 sm:py-32">
  <div class="mb-9 flex flex-col justify-between gap-4 sm:flex-row sm:items-end" data-reveal>
    <div><p class="eyebrow mb-4">05 / Learning</p><h2 class="text-3xl font-semibold tracking-[-.05em] sm:text-5xl">Credentials & badges.</h2></div>
    <p class="max-w-md text-xs leading-5 text-zinc-500">These items are listed in my resume. It does not include credential URLs, badge images, or completion dates, so they are not marked as independently verified here.</p>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    {credentials.map((credential) => <article class="card glass flex min-h-40 flex-col justify-between p-5" data-reveal>
      <div class="flex items-start justify-between gap-3"><span class="grid h-10 w-10 place-items-center rounded-xl border border-accent/20 bg-accent/10 font-mono text-[10px] font-semibold text-accent">{credential.mark}</span><span class="rounded-full border border-white/10 px-2 py-1 font-mono text-[8px] uppercase tracking-wider text-zinc-500">Resume-listed</span></div>
      <div class="mt-7"><h3 class="text-sm font-semibold leading-5 text-zinc-100">{credential.name}</h3><p class="mt-1.5 text-[10px] text-zinc-500">{credential.provider}</p></div>
    </article>)}
  </div>
</section>

<section id="education" class="container-shell scroll-mt-28 pb-24 sm:pb-32">
  <div class="mb-8" data-reveal><p class="eyebrow mb-3">06 / Education</p><h2 class="text-3xl font-semibold tracking-[-.05em] sm:text-4xl">Learning with analytical depth.</h2></div>
  <article class="glass card grid gap-5 p-6 sm:grid-cols-[1fr_auto] sm:items-center sm:p-8" data-reveal>
    <div><p class="eyebrow">University of Louisville</p><h3 class="mt-2 text-xl font-semibold">Master of Science, Business Analytics</h3><p class="mt-2 text-sm text-zinc-400">Aug 2025 — Aug 2026</p></div>
    <div class="rounded-2xl border border-mint/20 bg-mint/[.06] px-5 py-4"><p class="eyebrow text-mint">Resume-listed GPA</p><p class="mt-1 text-2xl font-semibold tracking-tight">3.8 <span class="text-sm font-normal text-zinc-500">/ 4.0</span></p></div>
  </article>
</section>
